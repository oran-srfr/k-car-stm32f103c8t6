{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "STM32: Build Debug",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/build.ps1", "-Action", "Build", "-Preset", "Debug"],
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "STM32: Build Release",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/build.ps1", "-Action", "Build", "-Preset", "Release"],
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "STM32: Reconfigure Debug",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/build.ps1", "-Action", "Configure", "-Preset", "Debug"],
      "problemMatcher": []
    },
    {
      "label": "STM32: Reconfigure Release",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/build.ps1", "-Action", "Configure", "-Preset", "Release"],
      "problemMatcher": []
    },
    {
      "label": "STM32: Flash Debug (writes board)",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/build.ps1", "-Action", "Flash"],
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "STM32: List ST-Link probes",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/build.ps1", "-Action", "Probe"],
      "problemMatcher": []
    },
    {
      "label": "STM32: Check tools",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tools/build.ps1", "-Action", "Check"],
      "problemMatcher": []
    },
    {
      "label": "STM32: Host Tests (requires host gcc)",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/tests/run_tests.ps1"],
      "problemMatcher": ["$gcc"]
    }
  ]
}
